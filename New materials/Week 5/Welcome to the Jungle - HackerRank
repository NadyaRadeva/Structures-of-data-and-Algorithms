#include <iostream>
#include <vector>
#include <stack>

using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<int> a(N);

    for (int i = 0; i < N; i++) {
        cin >> a[i];
    }

    vector<int> seen(N);

    stack<int> st;

    for (int i = N - 1; i >= 0; i--) {
        while (!st.empty() && st.top() <= a[i]) {
            st.pop();
        }

        st.push(a[i]);

        seen[i] = st.size();
    }

    int answer = 0;
    int best = seen[0];

    for (int i = 1; i < N; i++) {
        if (seen[i] > best) {
            best = seen[i];
            answer = i;
        }
    }

    cout << answer << "\n";

    return 0;
}
